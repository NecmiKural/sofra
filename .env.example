# SQLite connection string for Prisma. Relative paths are resolved from the
# prisma/ directory, so "../data/sofra.db" is the project's data/ folder.
# Use an absolute path in containers, e.g. file:/app/data/sofra.db
DATABASE_URL="file:../data/sofra.db"

# Secret used to sign session cookies — change in production!
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL (used on printable QR sheets). Falls back to the request host.

